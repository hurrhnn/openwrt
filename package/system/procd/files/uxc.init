#!/bin/sh /etc/rc.common

START=99
STOP=01
USE_PROCD=1
NAME=uxc
PROG=/sbin/uxc

start_service() {
	local ready

	ready=$(ubus call block status 2>/dev/null | jsonfilter -e '@.ready')
	[ "$ready" = "true" ] || return 0

	procd_open_instance "uxc"
	procd_set_param command "$PROG" boot
	procd_close_instance
}

reload_service() {
	"$PROG" boot
}

# At shutdown and reboot, stop every running container gracefully before the
# services stopped after it, such as storage and the network, go down.
# "uxc kill" without a signal sends SIGTERM to the container's init, sends
# SIGKILL after its stop-timeout, and returns once the container has stopped.
# stop and restart behave as before.
shutdown() {
	local name

	for name in $("$PROG" list --json 2>/dev/null | jsonfilter -e '@[@.status="running"].id' 2>/dev/null); do
		logger -t uxc "stopping container $name"
		"$PROG" kill "$name" >/dev/null 2>&1 &
	done
	wait
	stop
}

service_triggers() {
	procd_add_raw_trigger "mount.ready" 250 /etc/init.d/uxc reload
	procd_add_raw_trigger "mount.add" 250 /etc/init.d/uxc reload
	procd_add_raw_trigger "uxc.bringup" 250 /etc/init.d/uxc reload
}
