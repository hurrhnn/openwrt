diff --git a/mt7996/mt7996.h b/mt7996/mt7996.h
index 239e6d0..5c6e4c0 100644
--- a/mt7996/mt7996.h
+++ b/mt7996/mt7996.h
@@ -350,6 +350,30 @@ struct mt7996_vif_link_info {
 	struct ieee80211_tx_queue_params queue_params[IEEE80211_NUM_ACS];
 };
 
+
+/* MLO debug (W1700K local) */
+struct mt7996_mlo_dbg {
+	u32 tx[IEEE80211_NUM_TIDS][IEEE80211_MLD_MAX_NUM_LINKS];
+	u32 tx_final[IEEE80211_NUM_TIDS][IEEE80211_MLD_MAX_NUM_LINKS];
+	u32 tx_8023[IEEE80211_NUM_TIDS];
+	u32 txfree_link[IEEE80211_MLD_MAX_NUM_LINKS];
+	u32 txfree_no_link_sta;
+	u32 aggr_call[IEEE80211_NUM_TIDS];
+	u32 aggr_not_qos[IEEE80211_NUM_TIDS];
+	u32 aggr_bit_set[IEEE80211_NUM_TIDS];
+	u32 aggr_start_ok[IEEE80211_NUM_TIDS];
+	u32 aggr_start_err[IEEE80211_NUM_TIDS];
+	int aggr_last_err[IEEE80211_NUM_TIDS];
+};
+extern struct mt7996_mlo_dbg mt7996_mlo_dbg;
+extern bool mt7996_mlo_debug;
+#define mt7996_mlo_dbg_log(_dev, _fmt, ...)				\
+	do {								\
+		if (mt7996_mlo_debug)					\
+			dev_info((_dev)->mt76.dev, "mlo-dbg: " _fmt,	\
+				 ##__VA_ARGS__);			\
+	} while (0)
+
 struct mt7996_vif {
 	struct mt7996_vif_link deflink; /* must be first */
 	struct mt76_vif_data mt76;
