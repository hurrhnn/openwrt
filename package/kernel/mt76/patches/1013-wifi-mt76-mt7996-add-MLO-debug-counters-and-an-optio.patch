 mt7996/debugfs.c | 83 ++++++++++++++++++++++++++++++++++++++++++++++++
 mt7996/mac.c     | 46 ++++++++++++++++++++++++---
 mt7996/main.c    | 17 ++++++++++
 mt7996/mcu.c     |  9 ++++++
 mt7996/mt7996.h  | 24 ++++++++++++++
 5 files changed, 175 insertions(+), 4 deletions(-)

diff --git a/mt7996/debugfs.c b/mt7996/debugfs.c
index 404a9fe..2580fe0 100644
--- a/mt7996/debugfs.c
+++ b/mt7996/debugfs.c
@@ -1052,6 +1052,88 @@ static int mt7996_token_info_read(struct seq_file *s, void *data)
 	return 0;
 }
 
+/* MLO debug (W1700K local): per-TID link counters and MLO station state */
+static int
+mt7996_mlo_dbg_show(struct seq_file *file, void *data)
+{
+	struct mt7996_dev *dev = file->private;
+	struct mt7996_mlo_dbg *d = &mt7996_mlo_dbg;
+	int tid, l, i;
+
+	seq_printf(file, "params: mlo_debug=%d\n", mt7996_mlo_debug);
+	seq_puts(file, "TX link chosen (tx = by TID rule, final = wcid after get_tx_wcid), links 0..3\n");
+	seq_puts(file, "tid  tx[l0 l1 l2 l3]            final[l0 l1 l2 l3]         8023\n");
+	for (tid = 0; tid < IEEE80211_NUM_TIDS; tid++) {
+		seq_printf(file, "%u   ", tid);
+		for (l = 0; l < 4; l++)
+			seq_printf(file, " %u", d->tx[tid][l]);
+		seq_puts(file, "   |");
+		for (l = 0; l < 4; l++)
+			seq_printf(file, " %u", d->tx_final[tid][l]);
+		seq_printf(file, "   | %u\n", d->tx_8023[tid]);
+	}
+	seq_puts(file, "txfree wcid link (MLO sta):");
+	for (l = 0; l < 4; l++)
+		seq_printf(file, " l%d=%u", l, d->txfree_link[l]);
+	seq_printf(file, " no_link_sta=%u\n", d->txfree_no_link_sta);
+	seq_puts(file, "tx_check_aggr: tid call not_qos bit_set start_ok start_err last_err\n");
+	for (tid = 0; tid < IEEE80211_NUM_TIDS; tid++)
+		seq_printf(file, "  %u %u %u %u %u %u %d\n", tid,
+			   d->aggr_call[tid], d->aggr_not_qos[tid],
+			   d->aggr_bit_set[tid], d->aggr_start_ok[tid],
+			   d->aggr_start_err[tid], d->aggr_last_err[tid]);
+
+	seq_puts(file, "MLO stations: wcid link phy valid | sta def sec peer_mld mld_idx conn ampdu ba_tx ba_rx\n");
+	rcu_read_lock();
+	for (i = 0; i < ARRAY_SIZE(dev->mt76.wcid); i++) {
+		struct mt76_wcid *w = rcu_dereference(dev->mt76.wcid[i]);
+		struct mt7996_sta_link *msta_link;
+		struct ieee80211_sta *sta;
+		struct mt7996_sta *msta;
+
+		if (!w || !w->sta)
+			continue;
+		sta = wcid_to_sta(w);
+		if (!sta || !sta->mlo)
+			continue;
+		msta_link = container_of(w, struct mt7996_sta_link, wcid);
+		msta = msta_link->sta;
+		if (!msta)
+			continue;
+		seq_printf(file, "  %u %u %u %d | %pM %u %u 0x%x %u %u 0x%lx 0x%x 0x%x\n",
+			   w->idx, w->link_id, w->phy_idx, w->link_valid,
+			   sta->addr, msta->deflink_id, msta->seclink_id,
+			   msta->peer_mld_links, msta->fw_mld_idx,
+			   msta->conn_state, msta->deflink.wcid.ampdu_state,
+			   msta->ba_tx_mask, msta->ba_rx_mask);
+	}
+	rcu_read_unlock();
+
+	return 0;
+}
+
+static int
+mt7996_mlo_dbg_open(struct inode *inode, struct file *f)
+{
+	return single_open(f, mt7996_mlo_dbg_show, inode->i_private);
+}
+
+static ssize_t
+mt7996_mlo_dbg_write(struct file *f, const char __user *buf, size_t count,
+		     loff_t *ppos)
+{
+	memset(&mt7996_mlo_dbg, 0, sizeof(mt7996_mlo_dbg));
+	return count;
+}
+
+static const struct file_operations mt7996_mlo_dbg_fops = {
+	.open = mt7996_mlo_dbg_open,
+	.read = seq_read,
+	.write = mt7996_mlo_dbg_write,
+	.llseek = seq_lseek,
+	.release = single_release,
+};
+
 int mt7996_init_debugfs(struct mt7996_dev *dev)
 {
 	struct dentry *dir;
@@ -1063,6 +1145,7 @@ int mt7996_init_debugfs(struct mt7996_dev *dev)
 	debugfs_create_file("xmit-queues", 0400, dir, dev,
 			    &mt7996_xmit_queues_fops);
 	debugfs_create_file("tx_stats", 0400, dir, dev, &mt7996_tx_stats_fops);
+	debugfs_create_file("mlo_dbg", 0600, dir, dev, &mt7996_mlo_dbg_fops);
 	debugfs_create_file("sys_recovery", 0600, dir, dev,
 			    &mt7996_sys_recovery_ops);
 	debugfs_create_file("fw_debug_wm", 0600, dir, dev, &fops_fw_debug_wm);
diff --git a/mt7996/mac.c b/mt7996/mac.c
index 986b3af..ddd332e 100644
--- a/mt7996/mac.c
+++ b/mt7996/mac.c
@@ -11,6 +11,11 @@
 #include "mac.h"
 #include "mcu.h"
 
+struct mt7996_mlo_dbg mt7996_mlo_dbg;
+bool mt7996_mlo_debug;
+module_param_named(mlo_debug, mt7996_mlo_debug, bool, 0644);
+MODULE_PARM_DESC(mlo_debug, "log MLO station/link/BA events");
+
 #define to_rssi(field, rcpi)	((FIELD_GET(field, rcpi) - 220) / 2)
 
 static struct mt76_wcid *mt7996_rx_get_wcid(struct mt7996_dev *dev,
@@ -950,6 +955,10 @@ int mt7996_tx_prepare_skb(struct mt76_dev *mdev, void *txwi_ptr,
 		u8 tid = tx_info->skb->priority & IEEE80211_QOS_CTL_TID_MASK;
 
 		link_id = (tid % 2) ? msta->seclink_id : msta->deflink_id;
+		if (link_id < IEEE80211_MLD_MAX_NUM_LINKS)
+			mt7996_mlo_dbg.tx[tid][link_id]++;
+		if (is_8023)
+			mt7996_mlo_dbg.tx_8023[tid]++;
 	} else if (is_8023) {
 		/* mac80211 does not set the MLO link of an 802.3 frame */
 		link_id = IEEE80211_LINK_UNSPECIFIED;
@@ -1020,6 +1029,9 @@ int mt7996_tx_prepare_skb(struct mt76_dev *mdev, void *txwi_ptr,
 	}
 
 	wcid = mt7996_get_tx_wcid(wcid);
+	if (sta && sta->mlo && wcid->link_id < IEEE80211_MLD_MAX_NUM_LINKS)
+		mt7996_mlo_dbg.tx_final[tx_info->skb->priority &
+				       IEEE80211_QOS_CTL_TID_MASK][wcid->link_id]++;
 
 	pid = mt76_tx_status_skb_add(mdev, wcid, tx_info->skb);
 	memset(txwi_ptr, 0, MT_TXD_SIZE);
@@ -1164,12 +1176,32 @@ mt7996_tx_check_aggr(struct ieee80211_link_sta *link_sta,
 		     (IEEE80211_FCTL_FTYPE | IEEE80211_FCTL_STYPE);
 	}
 
-	if (unlikely(fc != (IEEE80211_FTYPE_DATA | IEEE80211_STYPE_QOS_DATA)))
+	mt7996_mlo_dbg.aggr_call[tid]++;
+	if (unlikely(fc != (IEEE80211_FTYPE_DATA | IEEE80211_STYPE_QOS_DATA))) {
+		mt7996_mlo_dbg.aggr_not_qos[tid]++;
 		return;
+	}
+
+	if (test_and_set_bit(tid, &wcid->ampdu_state)) {
+		mt7996_mlo_dbg.aggr_bit_set[tid]++;
+		return;
+	}
 
-	if (!test_and_set_bit(tid, &wcid->ampdu_state) &&
-	    ieee80211_start_tx_ba_session(link_sta->sta, tid, 0))
-		clear_bit(tid, &wcid->ampdu_state);
+	{
+		int ret = ieee80211_start_tx_ba_session(link_sta->sta, tid, 0);
+
+		if (ret) {
+			clear_bit(tid, &wcid->ampdu_state);
+			mt7996_mlo_dbg.aggr_start_err[tid]++;
+			mt7996_mlo_dbg.aggr_last_err[tid] = ret;
+			if (mt7996_mlo_debug)
+				pr_info_ratelimited("mt7996e mlo-dbg: start_tx_ba %pM tid %u link %u ret %d\n",
+						    link_sta->sta->addr, tid,
+						    link_sta->link_id, ret);
+		} else {
+			mt7996_mlo_dbg.aggr_start_ok[tid]++;
+		}
+	}
 }
 
 /* mt7996/mt7992 provide a HW MAC-TXP for AddBA req frames (MT_TXD7_MAC_TXD),
@@ -1293,6 +1325,12 @@ mt7996_mac_tx_free(struct mt7996_dev *dev, void *data, int len)
 			}
 
 			link_sta = rcu_dereference(sta->link[wcid->link_id]);
+			if (sta->mlo) {
+				if (!link_sta)
+					mt7996_mlo_dbg.txfree_no_link_sta++;
+				else if (wcid->link_id < IEEE80211_MLD_MAX_NUM_LINKS)
+					mt7996_mlo_dbg.txfree_link[wcid->link_id]++;
+			}
 			if (!link_sta)
 				goto next;
 next:
