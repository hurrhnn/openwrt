index 63d6f29..91ed415 100644
--- a/mt7996/mcu.h
+++ b/mt7996/mcu.h
@@ -1177,6 +1177,7 @@ enum {
 enum {
 	UNI_CMD_SDO_SET = 1,
 	UNI_CMD_SDO_QUERY,
+	UNI_CMD_SDO_SET_QOS_MAP = 4,
 	UNI_CMD_SDO_CP_MODE = 6,
 };
 
