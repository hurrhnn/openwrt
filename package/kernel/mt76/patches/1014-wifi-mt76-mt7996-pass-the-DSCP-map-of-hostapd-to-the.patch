--- a/mt7996/mt7996.h
+++ b/mt7996/mt7996.h
@@ -836,6 +836,8 @@ int mt7996_mcu_add_sta(struct mt7996_dev *dev,
 		       struct mt7996_vif_link *link,
 		       struct mt7996_sta_link *msta_link,
 		       int conn_state, bool newly);
+int mt7996_mcu_set_qos_map(struct mt7996_dev *dev,
