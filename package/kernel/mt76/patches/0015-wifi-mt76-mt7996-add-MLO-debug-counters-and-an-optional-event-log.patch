 	unsigned long add = new_links & ~old_links;
 	unsigned long rem = old_links & ~new_links;
@@ -2051,6 +2057,11 @@ mt7996_mac_sta_change_links(struct ieee80211_hw *hw, struct ieee80211_vif *vif,
 	}
 
 out:
+	mt7996_mlo_dbg_log(dev, "change_links %pM old 0x%x new 0x%x ret %d def %u sec %u peer_mld 0x%lx conn %d\n",
