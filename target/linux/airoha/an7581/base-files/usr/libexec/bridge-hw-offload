#!/bin/sh

SYS_NET="${BR_HW_SYS_NET:-/sys/class/net}"
FLOWTABLE="${BR_HW_FLOWTABLE:-fb}"
SETTLE_INTERVAL="${BR_HW_SETTLE_INTERVAL:-3}"
SETTLE_STABLE="${BR_HW_SETTLE_STABLE:-2}"
SETTLE_TIMEOUT="${BR_HW_SETTLE_TIMEOUT:-120}"
MAX_TRIES=2

LOCK=/var/lock/bridge-hw-offload.lock
PENDING=/var/run/bridge-hw-offload.pending
STATE=/var/run/bridge-hw-offload.state

fd_open() {
	local _n=10

	while [ "$_n" -lt 1024 ]; do
		if ! ( : >&"$_n" ) 2>/dev/null; then
			eval "exec $_n>\"\$2\"" || return 1
			eval "$1=\$_n"
			return 0
		fi
		_n=$((_n + 1))
	done

	return 1
}

is_true() {
	case "$1" in
	1|on|true|yes|enabled) return 0 ;;
	esac

	return 1
}

bridge_ports() {
	local brif

	for brif in "$SYS_NET"/*/brif; do
		[ -d "$brif" ] && ls "$brif"
	done 2>/dev/null | sort -u | tr '\n' ' '
}

fb_devices() {
	local json

	json=$(nft -j list flowtable bridge fw4 "$FLOWTABLE" 2>/dev/null) || return 0
	echo $(
		echo "$json" | jsonfilter -e '@.nftables[*].flowtable.dev[*]' 2>/dev/null ||
			echo "$json" | jsonfilter -e '@.nftables[*].flowtable.dev' 2>/dev/null
	) | tr ' ' '\n' | sort | xargs
}

missing_ports() {
	local fb=" $1 " p out=""

	for p in $(bridge_ports); do
		case "$fb" in
		*" $p "*) ;;
		*) out="$out $p" ;;
		esac
	done
	echo $out
}

wait_settle() {
	local prev="" cur stable=0 waited=0

	while [ "$waited" -lt "$SETTLE_TIMEOUT" ]; do
		cur=$(bridge_ports)
		[ -n "$cur" ] || return 0
		if [ "$cur" = "$prev" ]; then
			stable=$((stable + 1))
			[ "$stable" -ge "$SETTLE_STABLE" ] && return 0
		else
			stable=0
		fi
		prev="$cur"
		sleep "$SETTLE_INTERVAL"
		waited=$((waited + SETTLE_INTERVAL))
	done
}

sync_fb() {
	local fb missing tries=0 st_fb st_missing st_tries p

	is_true "$(uci -q get firewall.@defaults[0].flow_offloading)" || return 0
	is_true "$(uci -q get firewall.@defaults[0].flow_offloading_hw)" || return 0

	fb=$(fb_devices)
	for p in $fb; do
		[ -d "$SYS_NET/$p/bridge" ] && return 0
	done

	missing=$(missing_ports "$fb")
	if [ -z "$missing" ]; then
		rm -f "$STATE"
		return 0
	fi

	if [ -f "$STATE" ]; then
		{ read -r st_fb; read -r st_missing; read -r st_tries; } < "$STATE"
		[ "$st_fb" = "$fb" ] && [ "$st_missing" = "$missing" ] &&
			tries=${st_tries:-0}
	fi
	[ "$tries" -lt "$MAX_TRIES" ] || return 0

	logger -t bridge-hw-offload "$FLOWTABLE lacks bridge port(s) $missing, reloading firewall"
	eval "/etc/init.d/firewall reload ${LOCK_FD:+$LOCK_FD>&-} >/dev/null 2>&1"

	fb=$(fb_devices)
	missing=$(missing_ports "$fb")
	if [ -z "$missing" ]; then
		rm -f "$STATE"
	else
		[ "$st_fb" = "$fb" ] && [ "$st_missing" = "$missing" ] || tries=0
		printf '%s\n%s\n%s\n' "$fb" "$missing" "$((tries + 1))" > "$STATE"
	fi
}

run_worker() {
	(
		fd_open LOCK_FD "$LOCK" || exit 0
		while [ -e "$PENDING" ]; do
			flock -n "$LOCK_FD" || exit 0
			while [ -e "$PENDING" ]; do
				rm -f "$PENDING"
				wait_settle
				sync_fb
			done
			flock -u "$LOCK_FD"
		done
	) </dev/null >/dev/null 2>&1 &
}

request() {
	mkdir -p "${LOCK%/*}" "${PENDING%/*}"
	touch "$PENDING"
	run_worker
}

case "$1" in
request)
	shift
	request
	for delay in "$@"; do
		( sleep "$delay"; request ) </dev/null >/dev/null 2>&1 &
	done
	;;
sync)
	sync_fb
	;;
*)
	echo "usage: $0 request [DELAY...] | sync" >&2
	exit 1
	;;
esac
