+static void airoha_soe_expire_ctx(struct airoha_soe_sa *sa,
+				  struct list_head *head)
+{
+	struct airoha_soe_ctx *ctx, *tmp;
+	LIST_HEAD(expired);
+
+	spin_lock_bh(&sa->lock);
+	list_for_each_entry_safe(ctx, tmp, head, list) {
+		if (time_before(jiffies,
+				ctx->submitted + AIROHA_SOE_CTX_TIMEOUT))
+			break;
+		list_move_tail(&ctx->list, &expired);
+		atomic_dec(&sa->soe->queued_ctx);
+	}
+	spin_unlock_bh(&sa->lock);
+	airoha_soe_discard_ctx_list(sa, &expired);
