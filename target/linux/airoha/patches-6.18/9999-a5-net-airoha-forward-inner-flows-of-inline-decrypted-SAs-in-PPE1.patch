+/* xfrm_policy_walk() callback, called with xfrm_policy_lock held. Software
+ * accepts the plaintext of a tunnel-mode SA only under an input, forward or
+ * socket input policy with a tunnel template that the SA matches, see
+ * __xfrm_policy_check(), and a template matches an SOE SA only if it is an ESP
+ * tunnel template (xfrm_state_ok()): record the source prefix and the
+ * template of every such policy. Such a policy with more than one template,
+ * whose plaintext can be another tunnel, is not modelled: the walk fails.
+ */
+static int airoha_soe_inline_inner_src(struct xfrm_policy *pol, int dir,
+				       int count, void *ptr)
+{
+	const struct xfrm_selector *sel = &pol->selector;
+	const struct xfrm_tmpl *t = &pol->xfrm_vec[0];
+	struct airoha_soe_inner_walk *w = ptr;
+	struct airoha_ppe_soe_src *src;
+	int i;
+
+	if (dir % XFRM_POLICY_MAX == XFRM_POLICY_OUT ||
+	    pol->action != XFRM_POLICY_ALLOW)
+		return 0;
+	for (i = 0; i < pol->xfrm_nr; i++) {
+		if (pol->xfrm_vec[i].mode == XFRM_MODE_TUNNEL &&
+		    pol->xfrm_vec[i].id.proto == IPPROTO_ESP)
+			break;
+	}
+	if (i == pol->xfrm_nr)
+		return 0;
+	if (pol->xfrm_nr > 1 ||
+	    (sel->family != AF_INET && sel->family != AF_INET6) ||
+	    sel->prefixlen_s > (sel->family == AF_INET ? 32 : 128))
+		return -EOPNOTSUPP;
