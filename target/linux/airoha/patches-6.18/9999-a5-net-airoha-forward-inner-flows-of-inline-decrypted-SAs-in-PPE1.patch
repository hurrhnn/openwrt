+	src->peer = t->saddr.a4;
+	src->spi = t->id.spi;
+	src->reqid = t->reqid;
+	src->family = sel->family;
+	src->plen = sel->prefixlen_s;
+	src->esp4 = t->id.proto == IPPROTO_ESP && t->encap_family == AF_INET;
