+/* The soe_inline_inner source set: the prefixes of every network namespace,
+ * see airoha_soe_inline_inner_src(), as a conservative union. An error
+ * pointer if they cannot be read, -E2BIG beyond AIROHA_SOE_INNER_SRCS_MAX
+ * prefixes; airoha_ppe_soe_inner_set_srcs() then installs the failed set,
+ * which covers every bridged IP flow.
+ */
+static struct airoha_ppe_soe_srcs *airoha_soe_inline_inner_srcs(void)
+{
+	struct airoha_soe_inner_walk w = { .max = AIROHA_SOE_INNER_SRCS };
+	struct xfrm_policy_walk walk;
+	struct net *net;
+	int err;
+
+	for (;;) {
+		w.srcs = kzalloc(struct_size(w.srcs, src, w.max), GFP_KERNEL);
+		if (!w.srcs)
+			return ERR_PTR(-ENOMEM);
