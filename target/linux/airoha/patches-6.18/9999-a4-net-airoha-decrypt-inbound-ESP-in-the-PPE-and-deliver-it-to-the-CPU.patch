+		struct airoha_soe_sa *sa = rcu_dereference(soe->sa[i]);
+
+		if (sa && READ_ONCE(sa->inline_hash) == hash)
+			return sa;
+	}
+
+	return NULL;
+}
+
+/* The output of an outer entry (airoha_ppe_soe_inline_bind()) reaches the
+ * CPU on CDM1 queue 1 with the decrypt hop flag, the special tag of the
+ * entry, CPU reason 0x16 (hit bind, force to CPU), the index of the outer
+ * entry in PPE_ENTRY and the SA index, the ACTDP of the entry, in SW_UDF,
+ * which shares msg2 with the LRO count. The caller takes such a frame
+ * before the GDM, DSA and LRO handling, as it takes a CPU-path completion.
+ *
+ * Once an outer entry has been attached, every frame with hop flags 4 to 7
+ * that is not a CPU-path completion, every frame with the special tag and
+ * every frame that a recorded outer entry forced to the CPU is taken. On the
+ * normal path its plaintext would enter the stack without a secpath, on
+ * whatever device SPORT names. airoha_soe_rx_inline_skb() delivers what it
+ * can verify and drops the rest.
+ */
+bool airoha_soe_rx_inline_match(struct airoha_soe *soe, u32 msg0, u32 msg1)
+{
+	bool outer;
+
+	/* Gate on the count of inline-capable SAs, not the sticky inline_seen
+	 * flag: the classifier then disarms once soe_inline_rx=0 and the last
+	 * eligible SA has been replaced, instead of staying armed for the life
+	 * of the module.
+	 */
+	if (!soe || !atomic_read(&soe->inline_sas))
+		return false;
+
+	if (FIELD_GET(QDMA_ETH_RXMSG_HOP_FLAGS_MASK, msg0) >=
+	    AIROHA_SOE_HOP_FLAG_DECRYPTED)
+		return true;
+	if (FIELD_GET(AIROHA_SOE_RXMSG0_SPTAG16, msg0) ==
+	    AIROHA_SOE_INLINE_SPTAG)
+		return true;
+	if (FIELD_GET(QDMA_ETH_RXMSG_CRSN_MASK, msg1) != CRSN_22)
+		return false;
+
+	rcu_read_lock();
+	outer = !!airoha_soe_inline_sa_by_hash(soe,
+			FIELD_GET(QDMA_ETH_RXMSG_PPE_ENTRY_MASK, msg1));
+	rcu_read_unlock();
+
+	return outer;
+}
+
+/* Drop the link-layer padding behind the IP packet. */
+static bool airoha_soe_inline_trim(struct sk_buff *skb)
+{
+	unsigned int len;
+
+	if (skb->protocol == htons(ETH_P_IP)) {
+		const struct iphdr *iph = ip_hdr(skb);
+
+		len = ntohs(iph->tot_len);
+		if (iph->ihl < 5 || len < iph->ihl * 4)
+			return false;
+	} else {
+		len = sizeof(struct ipv6hdr) + ntohs(ipv6_hdr(skb)->payload_len);
+	}
+
+	if (len > skb->len)
+		return false;
+
+	return len == skb->len || !pskb_trim(skb, len);
+}
+
+/* Deliver the decrypted output of an outer entry like a CPU-path completion:
+ * a secpath with the SA and olen 0, so the inbound XFRM policy, conntrack and
+ * the firewall see the packet, on the device of the SA, through GRO. The
+ * engine checked and advanced the replay window of the SA; software checks
+ * the state and lifetime and accounts the packet. Anything that cannot be
+ * attributed to a bound inline SA with the decrypt hop flag is dropped.
+ */
+void airoha_soe_rx_inline_skb(struct airoha_soe *soe, struct sk_buff *skb,
+			      u32 msg0, u32 msg1, u32 msg2,
+			      struct napi_struct *napi)
+{
+	u32 entry = FIELD_GET(QDMA_ETH_RXMSG_PPE_ENTRY_MASK, msg1);
+	u32 hop = FIELD_GET(QDMA_ETH_RXMSG_HOP_FLAGS_MASK, msg0);
+	u32 udf = FIELD_GET(QDMA_ETH_RXMSG_SW_UDF_MASK, msg2);
+	enum airoha_soe_inline_sa_cnt why;
+	struct airoha_soe_xfrm_state *state;
+	struct airoha_soe_sa *sa, *sa_e;
+	struct net_device *dev;
+	struct xfrm_state *x;
+	struct sec_path *sp;
+	u16 etype;
+
+	if (!skb)
+		return;
+	if (!soe) {
+		kfree_skb(skb);
+		return;
+	}
+
+	/* RCU keeps @sa alive until it is pinned through its state below.
+	 *
+	 * SW_UDF carries the ACTDP that the engine used, which is the SA index:
+	 * it is the identity. PPE_ENTRY names the outer-entry slot and is used
+	 * only to reject a frame whose two identities disagree, and to recover
+	 * the identity when SW_UDF names nothing (it never did in testing). The
+	 * recorded hash is not required on the SW_UDF path, so a frame delivered
+	 * in the window where the hash is briefly cleared (a slot read that
+	 * timed out, or a re-commit in flight) is still attributed correctly
+	 * rather than black-holed.
+	 */
+	rcu_read_lock();
+	sa = udf < AIROHA_SOE_NUM_SA ? rcu_dereference(soe->sa[udf]) : NULL;
+	if (sa && !sa->inline_rx)
+		sa = NULL;
+	sa_e = (sa && READ_ONCE(sa->inline_hash) == entry) ? sa :
+	       airoha_soe_inline_sa_by_hash(soe, entry);
+	if (sa && sa_e && sa != sa_e) {
+		rcu_read_unlock();
+		atomic_long_inc(&soe->inline_cnt[AIROHA_SOE_INLINE_RX_CONFLICT]);
+		goto drop;
+	}
+	if (!sa)
+		sa = sa_e;
+	if (!sa) {
+		rcu_read_unlock();
+		atomic_long_inc(&soe->inline_cnt[AIROHA_SOE_INLINE_RX_NOSA]);
+		goto drop;
+	}
+
+	/* Only the engine sets the decrypt hop flag, and the outer entry forces
+	 * its output to the CPU with reason 0x16 (hit bind). A frame that misses
+	 * either is not a verified decrypt of this SA.
+	 */
+	if (hop != AIROHA_SOE_HOP_FLAG_DECRYPTED ||
+	    FIELD_GET(QDMA_ETH_RXMSG_CRSN_MASK, msg1) != CRSN_22) {
+		why = hop > AIROHA_SOE_HOP_FLAG_DECRYPTED ?
+		      AIROHA_SOE_INLINE_DROP_HOP :
+		      AIROHA_SOE_INLINE_DROP_UNVERIFIED;
+		goto drop_sa;
+	}
+
+	why = AIROHA_SOE_INLINE_DROP_L2;
+	if (!pskb_may_pull(skb, ETH_HLEN + 1))
+		goto drop_sa;
+	etype = get_unaligned_be16(skb->data + 2 * ETH_ALEN);
+	if (etype != ETH_P_IP && etype != ETH_P_IPV6 &&
+	    etype != AIROHA_SOE_INLINE_SPTAG)
+		goto drop_sa;
+
+	skb_reset_mac_header(skb);
+	skb_pull(skb, ETH_HLEN);
+	why = AIROHA_SOE_INLINE_DROP_IP;
+	if (airoha_soe_prepare_ip_headers(skb) ||
+	    (etype != AIROHA_SOE_INLINE_SPTAG && etype != ntohs(skb->protocol)) ||
+	    !airoha_soe_inline_trim(skb))
+		goto drop_sa;
+
+	why = AIROHA_SOE_INLINE_DROP_NOMEM;
+	sp = secpath_set(skb);
+	if (!sp || sp->len || sp->olen)
+		goto drop_sa;
+
+	why = AIROHA_SOE_INLINE_DROP_STATE;
+	x = READ_ONCE(sa->x);
+	if (!x || !refcount_inc_not_zero(&x->refcnt))
+		goto drop_sa;
+	/* Pins the state, its device and the driver state, and with them @sa
+	 * once state->sa is confirmed below.
+	 */
+	if (!xfrm_dev_offload_get(x)) {
+		xfrm_state_put(x);
+		goto drop_sa;
+	}
+
+	spin_lock(&x->lock);
+	state = (struct airoha_soe_xfrm_state *)x->xso.offload_handle;
+	if (x->xso.dir != XFRM_DEV_OFFLOAD_IN ||
+	    x->xso.type != XFRM_DEV_OFFLOAD_PACKET || !state ||
+	    state->sa != sa || !x->xso.dev || READ_ONCE(sa->dead) ||
+	    airoha_soe_inline_state_check_locked(x, skb->len)) {
+		spin_unlock(&x->lock);
+		xfrm_dev_offload_put(x);
+		xfrm_state_put(x);
+		goto drop_sa;
+	}
+	dev = x->xso.dev;
+	spin_unlock(&x->lock);
+
+	((struct ethhdr *)skb_mac_header(skb))->h_proto = skb->protocol;
+	skb->dev = dev;
+	skb->pkt_type = PACKET_HOST;
+	skb->ip_summed = CHECKSUM_NONE;
+	skb->encapsulation = 0;
+	skb_reset_mac_len(skb);
+	skb->mark = xfrm_smark_get(skb->mark, x);
+	nf_reset_ct(skb);
+	/* The secpath of airoha_soe_complete_in(): olen stays 0 and no flow
+	 * ID is set, so the inbound policy check runs and the flowtable does
+	 * not offload the inner flow. The secpath takes the state reference.
+	 */
+	sp->xvec[sp->len++] = x;
+	xfrm_dev_offload_put(x);
+	atomic_long_inc(&sa->inline_cnt[AIROHA_SOE_INLINE_DELIVERED]);
+	rcu_read_unlock();
+
+	if (napi)
+		napi_gro_receive(napi, skb);
+	else
+		netif_receive_skb(skb);
+	return;
+
+drop_sa:
+	atomic_long_inc(&sa->inline_cnt[why]);
+	rcu_read_unlock();
+drop:
+	kfree_skb(skb);
+}
+
+/* An inline frame was dropped before it was complete. It owns no CPU-path
+ * context.
+ */
+void airoha_soe_rx_inline_drop(struct airoha_soe *soe)
+{
+	if (soe)
+		atomic_long_inc(&soe->inline_cnt[AIROHA_SOE_INLINE_RX_RING]);
+}
+
+/* The legacy inbound binding copied the egress, L2 rewrite and data word of
+ * the first inner flow into the outer entry of the SA, so every later packet
+ * of the SA went to that one host without the XFRM policy check, conntrack
+ * or the firewall. Inbound SOE flowtable offers are therefore refused.
+ */
+void airoha_soe_ppe_refuse_input(struct airoha_soe *soe)
+{
+	if (soe)
+		atomic_long_inc(&soe->inline_cnt[AIROHA_SOE_INLINE_OFFER_REFUSED]);
+}
+
+static void airoha_soe_inline_bind_sa(struct airoha_soe *soe,
+				      struct airoha_soe_sa *sa, u32 hash)
+{
+	struct xfrm_state *x = sa->x;
+	struct net_device *dev;
+	int err = -ENOENT;
+
+	lockdep_assert_held(&soe->sa_lock);
+
+	if (!x || !refcount_inc_not_zero(&x->refcnt))
+		goto out;
+	if (!xfrm_dev_offload_get(x)) {
+		xfrm_state_put(x);
+		goto out;
+	}
+
+	dev = READ_ONCE(x->xso.dev);
+	if (dev && is_valid_ether_addr(dev->dev_addr))
+		err = airoha_ppe_soe_inline_bind(soe->eth, x, hash,
+						 dev->dev_addr);
+	xfrm_dev_offload_put(x);
+	xfrm_state_put(x);
+out:
+	spin_lock_bh(&sa->lock);
+	sa->inline_bind_err = err;
+	spin_unlock_bh(&sa->lock);
+	if (err)
+		atomic_long_inc(&sa->inline_cnt[AIROHA_SOE_INLINE_BIND_ERR]);
+}
+
+/* Bind the outer entry of an inline SA that asked for one, or check the
+ * recorded entry of an SA whose learned packets say it no longer serves
+ * the SA. soe->sa_lock keeps every listed SA alive and nests outside
+ * flow_offload_mutex, as in airoha_soe_alloc_sa().
+ */
+static void airoha_soe_inline_work(struct work_struct *work)
+{
+	struct airoha_soe *soe = container_of(work, struct airoha_soe,
+					      inline_work);
+	unsigned int i;
+
+	if (!airoha_soe_available(soe))
+		return;
+
+	mutex_lock(&soe->sa_lock);
+	for (i = 0; i < AIROHA_SOE_NUM_SA; i++) {
+		struct airoha_soe_sa *sa;
+		bool req, stale, flow;
+		u32 hash;
+
+		sa = rcu_dereference_protected(soe->sa[i],
+					       lockdep_is_held(&soe->sa_lock));
+		if (!sa || !sa->inline_rx)
+			continue;
+
+		spin_lock_bh(&sa->lock);
+		req = sa->inline_req && !sa->dead;
+		stale = sa->inline_stale;
+		hash = sa->inline_req_hash;
+		flow = !!sa->inline_flow;
+		sa->inline_req = false;
+		sa->inline_stale = false;
+		spin_unlock_bh(&sa->lock);
+		if (!req)
+			continue;
+
+		if (stale) {
+			/* An unbound entry is committed again by the next
+			 * learned packet; see airoha_soe_inline_unbound(). Only
+			 * a genuine still-bound slot (learned packets arriving
+			 * while the slot still reads BND) or a failed slot read
+			 * is counted; a held or vanished flow is not.
+			 */
+			switch (flow ? airoha_ppe_soe_inline_check(soe->eth, sa) :
+				       AIROHA_SOE_INLINE_CHECK_GONE) {
+			case AIROHA_SOE_INLINE_CHECK_BOUND:
+				atomic_long_inc(&sa->inline_cnt[AIROHA_SOE_INLINE_STILL_BOUND]);
+				break;
+			case AIROHA_SOE_INLINE_CHECK_UNKNOWN:
+				atomic_long_inc(&sa->inline_cnt[AIROHA_SOE_INLINE_CHECK_FAIL]);
+				break;
+			default:
+				break;
+			}
+			continue;
+		}
+		if (!flow)
+			airoha_soe_inline_bind_sa(soe, sa, hash);
+	}
+	mutex_unlock(&soe->sa_lock);
+}
