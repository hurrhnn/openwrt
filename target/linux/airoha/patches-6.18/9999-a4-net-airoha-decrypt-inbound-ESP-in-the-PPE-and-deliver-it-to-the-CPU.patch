+/* Decide whether the recorded slot of the outer entry of @sa still holds it
+ * bound. If the slot no longer holds the bound entry (it aged out or was
+ * invalidated) the flow is marked unbound, so that the next learned packet of
+ * the SA commits it again through airoha_ppe_foe_insert_entry(). A held entry
+ * waiting for the bind barrier is left alone, and a failed slot read is left
+ * bound and retried, rather than wrongly marked unbound (which would clear the
+ * recorded hash and black-hole the still-live entry).
+ */
+enum airoha_soe_inline_check
+airoha_ppe_soe_inline_check(struct airoha_eth *eth, struct airoha_soe_sa *sa)
+{
+	enum airoha_soe_inline_check res = AIROHA_SOE_INLINE_CHECK_GONE;
+	struct airoha_flow_table_entry *e;
+	struct airoha_soe_ppe_flow *flow;
+	struct airoha_foe_entry *hwe;
+
+	if (!eth || !eth->ppe || !sa)
+		return res;
+
+	/* SA flush and forget run under the same mutex, so the flow cannot
+	 * be released between the lookup and the check.
+	 */
+	mutex_lock(&flow_offload_mutex);
+	flow = airoha_soe_inline_flow(sa);
+	if (!flow)
+		goto unlock;
+
+	e = container_of(flow, struct airoha_flow_table_entry, soe_flow);
+	spin_lock_bh(&ppe_lock);
+	if (!list_empty(&e->soe_bind_node)) {
+		res = AIROHA_SOE_INLINE_CHECK_HELD;
+		goto unlock_ppe;
+	}
+	if (e->hash != 0xffff) {
+		hwe = airoha_ppe_foe_get_entry_locked(eth->ppe, e->hash);
+		if (!hwe) {
+			/* The FOE slot read timed out. Do not assume the entry
+			 * aged out: leave it bound and let the next learned
+			 * packet retry the check.
+			 */
+			res = AIROHA_SOE_INLINE_CHECK_UNKNOWN;
+			goto unlock_ppe;
+		}
+		if (FIELD_GET(AIROHA_FOE_IB1_BIND_STATE, hwe->ib1) ==
+		    AIROHA_FOE_STATE_BIND &&
+		    airoha_ppe_foe_compare_entry(e, hwe)) {
+			res = AIROHA_SOE_INLINE_CHECK_BOUND;
+			goto unlock_ppe;
+		}
+	}
+	res = AIROHA_SOE_INLINE_CHECK_UNBOUND;
+	airoha_soe_inline_unbound(flow);
+unlock_ppe:
+	spin_unlock_bh(&ppe_lock);
+unlock:
+	mutex_unlock(&flow_offload_mutex);
+
+	return res;
+}
