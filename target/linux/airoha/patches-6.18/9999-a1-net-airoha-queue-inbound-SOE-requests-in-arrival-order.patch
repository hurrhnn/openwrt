+static int airoha_soe_submit_skb(struct airoha_soe_sa *sa,
+				 struct airoha_gdm_dev *dev,
+				 struct sk_buff *skb,
+				 struct airoha_soe_ctx *ctx,
+				 struct xfrm_state *x)
+{
+	int err;
+
+	err = airoha_soe_prepare_skb(skb, ctx);
 	if (err)
 		return err;
 
 	return airoha_soe_submit_prepared_skb(sa, dev, skb, ctx, x, false);
 }
 
+/* Hand one queued inbound request to the engine. Called with sa->lock held.
+ * -EAGAIN keeps the request queued. On any other error the request is not
+ * in flight and the caller frees it.
+ */
+static int airoha_soe_rx_submit_locked(struct airoha_soe_sa *sa,
+				       struct airoha_soe_ctx *ctx,
+				       unsigned int *active_sub)
+{
+	struct airoha_gdm_dev *dev = ctx->rx.gdm;
+	struct sk_buff *skb = ctx->rx.pending_skb;
+	struct airoha_soe *soe = sa->soe;
+	unsigned long flags;
+	u32 msg0, msg1;
+	int err;
+
+	lockdep_assert_held(&sa->lock);
+
+	if (!dev || !skb || !dev->soe_xmit_skb)
+		return -ENODEV;
+
+	msg0 = FIELD_PREP(QDMA_ETH_TXMSG_SOE_SA_MASK, sa->index & 0x3f);
+	msg1 = FIELD_PREP(QDMA_ETH_TXMSG_METER_MASK, 0x7f) |
+	       FIELD_PREP(QDMA_ETH_TXMSG_FPORT_MASK, 7) |
+	       FIELD_PREP(QDMA_ETH_TXMSG_NBOQ_MASK,
+			  AIROHA_SOE_QDMA_QUEUE_DECRYPT) |
+	       QDMA_ETH_TXMSG_HOP_MASK |
+	       FIELD_PREP(QDMA_ETH_TXMSG_ACNT_G1_MASK, 0x1f) |
+	       FIELD_PREP(QDMA_ETH_TXMSG_ACNT_G0_MASK, 0x3f);
+
+	spin_lock_irqsave(&soe->seq_lock, flags);
+	/* An outbound PPE bind waits for every CPU request to drain, and a
+	 * stopped engine must not see new work. Both end with a kick.
+	 */
+	if (soe->seq_stopped || soe->ppe_bind_active) {
+		spin_unlock_irqrestore(&soe->seq_lock, flags);
+		return -EAGAIN;
+	}
+	if (sa->dead || !airoha_soe_available(soe)) {
+		spin_unlock_irqrestore(&soe->seq_lock, flags);
+		return -ENOENT;
+	}
+	if (sa->inflight >= AIROHA_SOE_SA_INFLIGHT_MAX) {
+		spin_unlock_irqrestore(&soe->seq_lock, flags);
+		return -EAGAIN;
+	}
+
+	skb->dev = netdev_from_priv(dev);
+	skb_set_queue_mapping(skb, AIROHA_SOE_QDMA_TX_RING);
+	airoha_soe_push_hop_desc(skb, sa->index, false);
+	ctx->submitted = jiffies;
+	list_add_tail(&ctx->list, &sa->rx_queue);
+	sa->inflight++;
+	if (atomic_inc_return(&soe->queued_ctx) == 1)
+		schedule_delayed_work(&soe->expire_work,
+				      AIROHA_SOE_CTX_EXPIRE_INTERVAL);
+	atomic_inc(&soe->active_ctx);
+	reinit_completion(&sa->idle);
+	spin_unlock_irqrestore(&soe->seq_lock, flags);
+
+	err = dev->soe_xmit_skb(dev, skb, msg0, msg1,
+				AIROHA_SOE_TXMSG2_DEFAULT);
+	if (err) {
+		list_del_init(&ctx->list);
+		atomic_dec(&soe->queued_ctx);
+		sa->inflight--;
+		(*active_sub)++;
+		return err;
+	}
+
+	/* The TX ring owns the skb now. */
+	ctx->rx.pending_skb = NULL;
+
+	return 0;
+}
+
+/* Submit queued inbound requests in arrival order while slots are free.
+ * Called with sa->lock held; the caller passes @failed and @active_sub to
+ * airoha_soe_rx_drain_done() after dropping the lock.
+ */
+static void airoha_soe_rx_drain_locked(struct airoha_soe_sa *sa,
+				       struct list_head *failed,
+				       unsigned int *active_sub)
+{
+	lockdep_assert_held(&sa->lock);
+
+	while (!list_empty(&sa->rx_pending)) {
+		struct airoha_soe_ctx *ctx;
+		int err;
+
+		ctx = list_first_entry(&sa->rx_pending, struct airoha_soe_ctx,
+				       list);
+		list_del_init(&ctx->list);
+		err = airoha_soe_rx_submit_locked(sa, ctx, active_sub);
+		if (err == -EAGAIN) {
+			list_add(&ctx->list, &sa->rx_pending);
+			break;
+		}
+		sa->rx_pending_len--;
+		atomic_dec(&sa->soe->rx_pending);
+		if (err)
+			list_add_tail(&ctx->list, failed);
+	}
+}
+
+static void airoha_soe_rx_drain_done(struct airoha_soe *soe,
+				     struct list_head *failed,
+				     unsigned int active_sub)
+{
+	struct airoha_soe_ctx *ctx, *tmp;
+
+	if (active_sub)
+		airoha_soe_active_ctx_sub(soe, active_sub);
+
+	list_for_each_entry_safe(ctx, tmp, failed, list) {
+		list_del(&ctx->list);
+		if (ctx->rx.x)
+			XFRM_INC_STATS(xs_net(ctx->rx.x), LINUX_MIB_XFRMINERROR);
+		kfree_skb(ctx->rx.pending_skb);
+		ctx->rx.pending_skb = NULL;
+		airoha_soe_free_ctx(ctx);
+	}
+}
+
+/* Queue a prepared inbound request behind earlier ones and submit what the
+ * in-flight window allows. On error the caller still owns @skb and @ctx.
+ */
+static int airoha_soe_rx_queue_skb(struct airoha_soe_sa *sa,
+				   struct airoha_gdm_dev *dev,
+				   struct sk_buff *skb,
+				   struct airoha_soe_ctx *ctx)
+{
+	struct airoha_soe *soe = sa->soe;
+	unsigned int active_sub = 0;
+	LIST_HEAD(failed);
+	int err;
+
+	err = airoha_soe_prepare_skb(skb, ctx);
+	if (err)
+		return err;
+
+	/* Reclaim lost requests first, as the direct submit path does. */
+	airoha_soe_expire_ctx(sa, &sa->rx_queue);
+
+	spin_lock_bh(&sa->lock);
+	if (sa->dead || !airoha_soe_available(soe)) {
+		err = -ENOENT;
+	} else if (sa->rx_pending_len >= AIROHA_SOE_RX_PENDING_MAX) {
+		err = -ENOSPC;
+	} else {
+		ctx->rx.gdm = dev;
+		ctx->rx.pending_skb = skb;
+		list_add_tail(&ctx->list, &sa->rx_pending);
+		sa->rx_pending_len++;
+		atomic_inc(&soe->rx_pending);
+		airoha_soe_rx_drain_locked(sa, &failed, &active_sub);
+	}
+	spin_unlock_bh(&sa->lock);
+	airoha_soe_rx_drain_done(soe, &failed, active_sub);
+
+	return err;
+}
+
+/* Resubmit queued inbound requests after an outbound PPE bind or an engine
+ * stop ended. Nothing else would wake them when no request is in flight.
+ */
+static void airoha_soe_rx_kick_work(struct work_struct *work)
+{
+	struct airoha_soe *soe =
+		container_of(work, struct airoha_soe, rx_kick_work);
+	unsigned int i;
+
+	if (!atomic_read(&soe->rx_pending))
+		return;
+
+	rcu_read_lock();
+	for (i = 0; i < AIROHA_SOE_NUM_SA; i++) {
+		struct airoha_soe_sa *sa = rcu_dereference(soe->sa[i]);
+		unsigned int active_sub = 0;
+		LIST_HEAD(failed);
+
+		if (!sa || (sa->cmd & AIROHA_SOE_SA_CMD_ENC))
+			continue;
+
+		spin_lock_bh(&sa->lock);
+		if (!sa->dead)
+			airoha_soe_rx_drain_locked(sa, &failed, &active_sub);
+		spin_unlock_bh(&sa->lock);
+		airoha_soe_rx_drain_done(soe, &failed, active_sub);
+	}
+	rcu_read_unlock();
+}
+
