@@ -443,16 +459,40 @@ u32 airoha_soe_features(struct airoha_so
 	return airoha_soe_available(soe) ? AIROHA_SOE_FEATURE_ESP : 0;
 }
 
+static void airoha_soe_purge_rx_pending(struct airoha_soe *soe,
+					struct list_head *head,
+					unsigned int count)
+{
+	struct airoha_soe_ctx *ctx, *tmp;
+
+	if (count)
+		atomic_sub(count, &soe->rx_pending);
+	list_for_each_entry_safe(ctx, tmp, head, list) {
+		list_del(&ctx->list);
+		kfree_skb(ctx->rx.pending_skb);
+		ctx->rx.pending_skb = NULL;
+		airoha_soe_free_ctx(ctx);
+	}
+}
+
 static void airoha_soe_mark_sa_dead(struct airoha_soe_sa *sa)
 {
+	LIST_HEAD(rx_pending);
+	unsigned int npending;
+
 	if (!sa)
 		return;
 
 	spin_lock_bh(&sa->lock);
 	sa->dead = true;
+	/* Queued inbound requests never reached the engine; drop them. */
+	npending = sa->rx_pending_len;
+	sa->rx_pending_len = 0;
+	list_splice_init(&sa->rx_pending, &rx_pending);
 	if (!sa->inflight)
 		complete(&sa->idle);
 	spin_unlock_bh(&sa->lock);
+	airoha_soe_purge_rx_pending(sa->soe, &rx_pending, npending);
 	airoha_soe_purge_bind_tx(sa->soe, sa);
 }
 
