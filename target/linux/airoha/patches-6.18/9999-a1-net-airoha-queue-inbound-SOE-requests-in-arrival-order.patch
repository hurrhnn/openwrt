 		goto sw_tag;
 
 	ctx = kzalloc_obj(*ctx, GFP_ATOMIC);
@@ -2850,7 +3112,14 @@ bool airoha_soe_rx_plain_skb(struct airo
 	if (skb->len != info.packet_len && pskb_trim(skb, info.packet_len))
