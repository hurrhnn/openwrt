 	if (!WARN_ON_ONCE(!sa->inflight)) {
 		sa->inflight--;
-		finished = true;
+		active_sub++;
 		if (sa->dead && !sa->inflight)
 			complete(&sa->idle);
+		else if (!sa->dead)
+			/* Refill the slot this completion freed, in order. */
+			airoha_soe_rx_drain_locked(sa, &failed, &active_sub);
 	}
 	spin_unlock_bh(&sa->lock);
-	if (finished)
-		airoha_soe_active_ctx_sub(sa->soe, 1);
+	airoha_soe_rx_drain_done(soe, &failed, active_sub);
 }
 
