+static void
+airoha_ppe_foe_claim_entry(struct airoha_ppe *ppe,
+			   struct airoha_flow_table_entry *e, u32 hash)
+{
+	struct airoha_flow_table_entry *iter;
+	struct hlist_node *n;
+	u32 index;
+
+	lockdep_assert_held(&ppe_lock);
+
+	index = e->type == FLOW_TYPE_L2_SUBFLOW ?
+			hash : airoha_ppe_foe_get_entry_hash(ppe, &e->data);
+	hlist_for_each_entry_safe(iter, n, &ppe->foe_flow[index], list) {
+		if (iter == e || iter->hash != hash)
+			continue;
+
+		iter->hash = 0xffff;
+		if (iter->type != FLOW_TYPE_L2_SUBFLOW)
+			continue;
+
+		hlist_del_init(&iter->l2_subflow_node);
+		hlist_del_init(&iter->list);
+		kfree(iter);
+	}
+	e->hash = hash;
+}
+static struct airoha_foe_entry *
+airoha_ppe_foe_find_learned_entry(struct airoha_ppe *ppe,
+				  struct airoha_flow_table_entry *e, u32 *hash)
+{
+	const u32 set_mask = (PPE_SRAM_NUM_ENTRIES / 4) - 1;
+	const int set_shift = __ffs(PPE_SRAM_NUM_ENTRIES / 4);
+	const struct airoha_foe_ipv4_tuple *tuple = &e->data.ipv4.orig_tuple;
+	struct airoha_foe_entry *hwe;
+	u32 base, value;
+	int i, way;
+
+	lockdep_assert_held(&ppe_lock);
+
+	/* PPE SRAM hash 0 uses mode 0 and four ways. Match a learned entry
+	 * instead of writing the legacy software hash, which does not identify
+	 * a hardware SRAM slot on EN7581.
+	 */
+	value = PPE_HASH_SEED;
+	value = (value >> 24) | (value << 8);
+	value ^= tuple->ports ^ tuple->dest_ip ^ tuple->src_ip;
+	base = (value & set_mask) ^ ((value >> set_shift) & set_mask) ^
+	       (value >> (2 * set_shift));
+	base = (base & set_mask) * 4;
+
+	for (i = 0; i < ppe->eth->soc->num_ppe; i++) {
+		for (way = 0; way < 4; way++) {
+			u32 candidate = i * PPE_SRAM_NUM_ENTRIES + base + way;
+			u32 state;
+
+			hwe = airoha_ppe_foe_get_entry_locked(ppe, candidate);
+			if (!hwe)
+				continue;
+
+			state = FIELD_GET(AIROHA_FOE_IB1_BIND_STATE, hwe->ib1);
+			if (state != AIROHA_FOE_STATE_UNBIND ||
+			    !airoha_ppe_foe_compare_entry(e, hwe))
+				continue;
+
+			*hash = candidate;
+			return hwe;
+		}
+	}
+
+	return NULL;
+}
 
