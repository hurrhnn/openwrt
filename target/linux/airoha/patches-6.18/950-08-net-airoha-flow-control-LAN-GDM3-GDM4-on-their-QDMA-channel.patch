From: hurrhnn <hurrhnn@icmp.kr>
Date: Mon, 28 Sep 2026 01:30:00 +0900
Subject: [PATCH] net: airoha: flow-control LAN GDM3/GDM4 on their QDMA channel

The FE keeps one flow-control slot per QDMA TX channel (FE 0x1b0 for the
LAN QDMA, 0x21b0 for the WAN QDMA; two 16-bit slots per register, the
even channel in the low half-word). A slot holds the PSE (port, output
queue), encoded as PSE_PORT[8:5] | OQ[4:0], whose congestion pauses that
channel. Nothing programs the map, so the LAN QDMA keeps its reset
layout, channel n <-> GDM1 OQ n, which matches the DSA user ports.

A LAN GDM3/GDM4 device transmits on channel
port->id % AIROHA_NUM_QOS_CHANNELS, both for CPU xmit and for PPE
hw-forwarding, so GDM4 uses channel 0, which is watched by GDM1 OQ0 (only
used by CPU xmit through the DSA conduit). GDM4 congestion therefore never
pauses its QDMA channel and the GDM4 output queue grows into the whole PSE
shared buffer; every other WAN->LAN flow is then dropped when it enters
CDM1.

Point the slot of the device channel at the device output queue and hand
it back to GDM1 when the device moves to the WAN QDMA. The excess of a
congested GDM3/GDM4 port is then dropped per channel at QDMA hw-forward
admission, as it already is for the DSA ports, and no longer takes the
shared buffer from the other ports. The vendor SDK remaps QDMA slots the
same way (fe_set_qdma_fc_map()). Limited to EN7581, where the map layout
is known.

Signed-off-by: hurrhnn <hurrhnn@icmp.kr>
---
--- a/drivers/net/ethernet/airoha/airoha_regs.h
+++ b/drivers/net/ethernet/airoha/airoha_regs.h
@@ -82,6 +82,13 @@
 #define PSE_SHARE_USED_MTHD_MASK	GENMASK(31, 16)
 #define PSE_SHARE_USED_HTHD_MASK	GENMASK(15, 0)
 
+#define REG_FE_QDMA_FC_MAP(_q, _ch)	(((_q) ? 0x21b0 : 0x01b0) +	\
+					 (((_ch) >> 1) << 2))
+#define FE_QDMA_FC_MAP_SHIFT(_ch)	(((_ch) & 1) << 4)
+#define FE_QDMA_FC_MAP_SLOT_MASK	GENMASK(15, 0)
+#define FE_QDMA_FC_MAP_PORT_MASK	GENMASK(8, 5)
+#define FE_QDMA_FC_MAP_QUEUE_MASK	GENMASK(4, 0)
+
 #define REG_GDM_MISC_CFG		0x0148
 #define GDM2_RDM_ACK_WAIT_PREF_MASK	BIT(9)
 #define GDM2_CHN_VLD_MODE_MASK		BIT(5)
--- a/drivers/net/ethernet/airoha/airoha_eth.c
+++ b/drivers/net/ethernet/airoha/airoha_eth.c
@@ -2417,6 +2417,37 @@
 	return NULL;
 }
 
+static void airoha_fe_set_qdma_fc_map(struct airoha_eth *eth, int qdma_id,
+				      int channel, u32 pse_port, u32 queue)
+{
+	u32 shift = FE_QDMA_FC_MAP_SHIFT(channel);
+	u32 val = FIELD_PREP(FE_QDMA_FC_MAP_PORT_MASK, pse_port) |
+		  FIELD_PREP(FE_QDMA_FC_MAP_QUEUE_MASK, queue);
+
+	airoha_fe_rmw(eth, REG_FE_QDMA_FC_MAP(qdma_id, channel),
+		      FE_QDMA_FC_MAP_SLOT_MASK << shift, val << shift);
+}
+
+static void airoha_dev_update_qdma_fc_map(struct airoha_gdm_dev *dev)
+{
+	struct airoha_gdm_port *port = dev->port;
+	int channel = port->id % AIROHA_NUM_QOS_CHANNELS;
+	struct airoha_eth *eth = dev->eth;
+
+	if (!airoha_is_7581(eth))
+		return;
+
+	if (port->id != AIROHA_GDM3_IDX && port->id != AIROHA_GDM4_IDX)
+		return;
+
+	if (airoha_is_lan_gdm_dev(dev))
+		airoha_fe_set_qdma_fc_map(eth, 0, channel,
+					  airoha_get_fe_port(dev), dev->nbq);
+	else
+		airoha_fe_set_qdma_fc_map(eth, 0, channel,
+					  FE_PSE_PORT_GDM1, channel);
+}
+
 static void airoha_dev_set_qdma(struct airoha_gdm_dev *dev)
 {
 	struct net_device *netdev = netdev_from_priv(dev);
@@ -2432,6 +2463,7 @@
 
 	rcu_assign_pointer(dev->qdma, qdma);
 	netdev->irq = qdma->irq_banks[0].irq;
+	airoha_dev_update_qdma_fc_map(dev);
 
 	ppe_id = !airoha_is_lan_gdm_dev(dev) && airoha_ppe_is_enabled(eth, 1);
 	airoha_ppe_set_cpu_port(dev, ppe_id, airoha_get_fe_port(dev));
